# Environment Configuration
# Copy this file to .env and update with your values

# Database
DATABASE_URL=sqlite:///./tsetmc.db

# API Settings
API_TIMEOUT=10
API_RETRIES=3
API_RETRY_DELAY=1

# API Base URLs
TSE_BASE_URL=https://service.tsetmc.com
TGJU_BASE_URL=https://api.tgju.org

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Application
DEBUG=False
ENVIRONMENT=development
